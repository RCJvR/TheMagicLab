      ],
      "optionsAf": [
        "8",
        "14",
        "20",
        "6"
      ],
      "answer": 2,
      "explain": "Range = largest − smallest, so largest = 14 + 6 = 20.",
      "explainAf": "Omvang = grootste − kleinste, dus is die grootste = 14 + 6 = 20."
