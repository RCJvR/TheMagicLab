      "skill": "calculation",
      "variant": "A",
      "q": "The angle of elevation to the top of a building is 30° from a point 20 m from its base. What is the height? (Use tan 30° = 1/√3)",
      "qAf": "Die hoogtehoek na die bopunt van ’n gebou is 30° vanaf ’n punt 20 m van die basis. Wat is die hoogte? (Gebruik tan 30° = 1/√3)",
      "options": [
        "10 m",
        "20/√3 m",
        "20√3 m",
        "40 m"
      ],
      "optionsAf": [
        "10 m",
        "20/√3 m",
        "20√3 m",
        "40 m"
      ],
      "answer": 1,
      "explain": "h = 20 × tan 30° = 20/√3 m (about 11,5 m).",
      "explainAf": "h = 20 × tan 30° = 20/√3 m (ongeveer 11,5 m)."
    },
