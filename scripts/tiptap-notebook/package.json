{
  "name": "magic-lab-tiptap-notebook",
  "private": true,
  "description": "Builds assets/vendor/tiptap-notebook-3.32.1.bundle.js for Study Spellbook, the learner notebook (run: npm install && npm run build). Separate from the Grading Grimoire bundle so that one stays untouched. node_modules is not committed.",
  "scripts": {
    "build": "esbuild entry.js --bundle --format=esm --minify --legal-comments=eof --target=es2020 --outfile=../../assets/vendor/tiptap-notebook-3.32.1.bundle.js"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "@tiptap/core": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "@tiptap/extension-table": "3.32.1",
    "@tiptap/extension-image": "3.32.1",
    "@tiptap/extension-subscript": "3.32.1",
    "@tiptap/extension-superscript": "3.32.1",
    "@tiptap/extension-highlight": "3.32.1",
    "@tiptap/extension-text-style": "3.32.1",
    "@tiptap/extension-list": "3.32.1",
    "@tiptap/extensions": "3.32.1"
  }
}
